# Example .env.local file for development
# Copy this file to each service directory and modify as needed

# Database Connection Strings
ConnectionStrings__DefaultConnection=Server=localhost;Database=BookingDatabase;Username=postgres;Password=postgres;
ConnectionStrings__Redis=localhost:6379

# RabbitMQ Message Broker
MessageBroker__Host=amqp://localhost:5672
MessageBroker__Username=guest
MessageBroker__Password=guest

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Logging Level (optional)
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# CORS Settings (optional - defaults to localhost:3000)
# CORS__AllowedOrigins=http://localhost:3000;https://localhost:3000

# Service-specific settings can be added here
# For example:
# JWT__SecretKey=your-super-secret-key-here
# JWT__Issuer=booking-api
# JWT__Audience=booking-frontend
