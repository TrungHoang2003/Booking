{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": [
      {
        "RouteId": "identity-route",
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"  
               },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      }
    ],
    "Clusters": [
      {
        "ClusterId": "identity-cluster",
        "Destinations": {
          "identity-destination": {
            "Address": "https://localhost:5194/" 
          }
        }
      }
    ]
  }
}