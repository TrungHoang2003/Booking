{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/Identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/Identity"
          }
        ]
      },
      "property-route": {
        "ClusterId": "property-cluster",
        "Match": {
          "Path": "/Property/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/Property"
          }
        ]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://localhost:5194/"
          }
        }
      },
      "property-cluster": {
        "Destinations": {
          "property-destination": {
            "Address": "http://localhost:5229/"
          }
        }
      }
    }
  }
}
